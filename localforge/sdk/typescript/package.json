{
  "name": "@localforge/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for LocalForge daemon",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "node --test dist/esm/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "localforge",
    "identity",
    "config",
    "entitlements"
  ],
  "author": "LocalForge Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/localforge/localforge"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "typescript": "^5.3.0"
  }
}
